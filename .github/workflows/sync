name: Sync upstream Mainsail

on:
  schedule:
    - cron: '0 6 * * *'
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v3
        with:
          ref: develop
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Sync upstream
        run: |
          git remote add upstream https://github.com/mainsail-crew/mainsail.git
          git fetch upstream
          git merge upstream/develop --no-edit || echo "Merge conflicts detected — manual intervention needed"
          git push origin develop
